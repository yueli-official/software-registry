{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "venera",
  "name": "Venera",
  "homepage": "https://github.com/venera-app/venera",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "venera-app/venera",
          "assetPattern": "Venera-*-windows.zip",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "venera-app/venera",
          "assetPattern": "venera-{version}+163.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "android",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "venera-app/venera",
          "assetPattern": "venera-{version}.apk",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "venera-app/venera",
          "assetPattern": "venera_{version}_amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "venera-app/venera",
          "assetPattern": "venera_{version}_arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "漫画阅读工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/venera-app/venera/a0eba914f4c2a84ac1bc925adec2baabe920b9be/macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_512.png",
    "sha256": "7f0e6f815691f46fc7f6f133a37e84762a72cb8db477ef9bec11b6a8d11de30b",
    "mime": "image/png"
  },
  "description": "Venera 用于漫画阅读。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 按软件说明配置你有权访问的漫画来源。打开书目开始阅读，再设置翻页与显示方式。\n\n### 其他平台安装\n- macOS universal：打开 DMG 并将应用拖入“应用程序”。\n- Android universal：在 Android 设备打开 APK，按系统提示允许当前安装来源并安装；安装后可关闭该来源权限。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Linux arm64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "category": "reading",
  "screenshots": []
}
