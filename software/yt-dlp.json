{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "yt-dlp",
  "name": "yt-dlp",
  "homepage": "https://github.com/yt-dlp/yt-dlp",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "main",
          "app": "yt-dlp",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "yt-dlp/yt-dlp",
          "assetPattern": "yt-dlp_linux.zip",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "yt-dlp/yt-dlp",
          "assetPattern": "yt-dlp_linux_aarch64.zip",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "yt-dlp/yt-dlp",
          "assetPattern": "yt-dlp_macos.zip",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    }
  ],
  "summary": "支持多个站点的命令行音视频下载工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/yt-dlp/yt-dlp/51bab8a0116f4d8004c315706d809782607d5847/devscripts/logo.ico",
    "sha256": "09690324b9d3b2f381821404360dbec6b7a67a85a0b9db601c11bd2e27a58f83",
    "mime": "image/x-icon"
  },
  "description": "yt-dlp：支持多个站点的命令行音视频下载工具。",
  "usageInstructions": "1. 在下载区选择与你的系统相符的原版包，安装或解压。\n2. 打开终端运行 yt-dlp --version。使用 yt-dlp \"视频地址\" 下载你有权保存的内容；需要合并音视频时按官方说明安装 FFmpeg。\n\n### 其他平台安装\n- Linux amd64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。\n- Linux arm64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。\n- macOS universal：解压原版包，应用拖入“应用程序”；命令行工具在终端按官方文档使用。",
  "faq": "系统要求和功能限制以官方说明为准。操作重要文件、分区或配置前请先备份。",
  "category": "media",
  "screenshots": []
}
