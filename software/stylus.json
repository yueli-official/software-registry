{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "stylus",
  "name": "Stylus",
  "homepage": "https://add0n.com/stylus.html",
  "kind": "chrome-extension",
  "packages": [
    {
      "platform": "windows",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "openstyles/stylus",
          "tagPrefix": "v",
          "assetPattern": "stylus-chrome-mv3-v{version}-id.zip"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "openstyles/stylus",
          "tagPrefix": "v",
          "assetPattern": "stylus-chrome-mv3-v{version}-id.zip",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "openstyles/stylus",
          "tagPrefix": "v",
          "assetPattern": "stylus-chrome-mv3-v{version}-id.zip",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "网页样式扩展工具。",
  "icon": {
    "url": "https://icons.add0n.com/stylus64.png",
    "sha256": "550a1b6e9fed3ca668b0d3af835171eff9ac6b9f5c832017e86c3380ce430b55",
    "mime": "image/png"
  },
  "description": "Stylus 用于网页样式扩展。",
  "usageInstructions": "1. 下载官方 Chromium 扩展 ZIP 并解压到固定目录。\n2. 打开 Chromium 浏览器扩展管理页面，启用开发者模式，选择“加载已解压的扩展程序”并选中解压目录。\n3. 按官方说明配置功能与网站权限；目录须保留，普通用户也可选择官方扩展商店安装。",
  "faq": "这里提供官方 Chromium 扩展发行包，Windows、macOS 和 Linux 使用相同原包。它不是系统安装程序；手动加载需启用浏览器开发者模式。",
  "documentationUrl": "https://github.com/openstyles/stylus/blob/master/README.md",
  "category": "browser",
  "screenshots": []
}
