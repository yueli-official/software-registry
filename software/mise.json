          "assetPattern": "mise-v{version}-linux-x64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "jdx/mise",
          "assetPattern": "mise-v{version}-linux-arm64.tar.gz",
