        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "siyuan-note/siyuan",
          "assetPattern": "siyuan-{version}-mac-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "siyuan-note/siyuan",
          "assetPattern": "siyuan-{version}-linux.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "siyuan-note/siyuan",
          "assetPattern": "siyuan-{version}-linux-arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "android",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "siyuan-note/siyuan",
          "assetPattern": "siyuan-{version}.apk",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
