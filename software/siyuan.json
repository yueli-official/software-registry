          "repository": "siyuan-note/siyuan",
          "assetPattern": "siyuan-{version}-win-arm64.exe",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "siyuan-note/siyuan",
          "assetPattern": "siyuan-{version}-mac.dmg",
          "tagPrefix": "v",
