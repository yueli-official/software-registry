        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "orhun/git-cliff",
          "assetPattern": "git-cliff-{version}-x86_64-apple-darwin.tar.gz",
