          "bucket": "main",
          "app": "gitleaks",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "windows",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "gitleaks/gitleaks",
          "assetPattern": "gitleaks_{version}_windows_arm64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
