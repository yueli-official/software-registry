    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "gitleaks/gitleaks",
          "assetPattern": "gitleaks_{version}_linux_x64.tar.gz",
          "tagPrefix": "v",
