{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "gitleaks",
  "name": "Gitleaks",
  "homepage": "https://github.com/gitleaks/gitleaks",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
