{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "watt-toolkit",
  "name": "Watt Toolkit",
  "homepage": "https://steampp.net",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "BeyondDimension/SteamTools",
          "assetPattern": "Steam++_*_win_x64.exe",
          "tagPrefix": ""
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "BeyondDimension/SteamTools",
          "assetPattern": "Steam++_v{version}_linux_x64.tgz",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "BeyondDimension/SteamTools",
          "assetPattern": "Steam++_v{version}_macos.dmg",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    }
  ],
  "summary": "游戏平台工具工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/BeyondDimension/SteamTools/d04213147e77a8d73277fa8b86eeecfa444df071/src/BD.WTTS.Client.Avalonia.App/Assets.xcassets/AppIcon.appiconset/Icon512.png",
    "sha256": "eef4782ba951b694ba9650aff09f0eed26662c4bd24705324a32b38286dfb402",
    "mime": "image/png"
  },
  "description": "Watt Toolkit 用于游戏平台工具。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 打开软件选择需要的网络或游戏平台工具。根据模块说明启用服务并测试，凭据与平台账号自行管理。\n\n### 其他平台安装\n- Linux amd64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。\n- macOS universal：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "category": "games",
  "screenshots": []
}
