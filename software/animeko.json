{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "animeko",
  "name": "Animeko",
  "homepage": "https://animeko.org",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "open-ani/animeko",
          "assetPattern": "ani-*-windows-x86_64.zip",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "android",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "open-ani/animeko",
          "assetPattern": "ani-{version}-universal.apk",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "视频客户端工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/open-ani/animeko/cd0ad5ca8dc501fb06426d83870f49e7e3b0adef/app/ios/Animeko/Assets.xcassets/AppIcon.appiconset/512.png",
    "sha256": "6846aeb25d2fdf748280d7692936f116379c8fa3d9887aa42fd020295e3f42fb",
    "mime": "image/png"
  },
  "description": "Animeko 用于视频客户端。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 启动后按提示配置受支持且有权访问的内容来源。搜索并播放内容，在设置中调整播放器、字幕和缓存。\n\n### 其他平台安装\n- Android universal：在 Android 设备打开 APK，按系统提示允许当前安装来源并安装；安装后可关闭该来源权限。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "documentationUrl": "https://github.com/open-ani/animeko/blob/main/README.md",
  "category": "media",
  "screenshots": []
}
