    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "meetfranz/franz",
          "assetPattern": "Franz-{version}.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "meetfranz/franz",
          "assetPattern": "Franz-{version}-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
