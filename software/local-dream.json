{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "local-dream",
  "name": "Local Dream",
  "homepage": "https://play.google.com/store/apps/details?id=io.github.xororz.localdream",
  "kind": "package",
  "packages": [
    {
      "platform": "android",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "xororz/local-dream",
          "tagPrefix": "v",
          "assetPattern": "LocalDream_armv8a_{version}.apk"
        }
      }
    }
  ],
  "summary": "安卓本地 AI 绘图工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/xororz/local-dream/18be9aa6e8365d6efb9601acf7c13f7147214aa7/assets/icon.png",
