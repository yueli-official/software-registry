{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "moekoemusic",
  "name": "MoeKoeMusic",
  "homepage": "https://Music.MoeKoe.cn",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "MoeKoeMusic/MoeKoeMusic",
          "assetPattern": "MoeKoe_Music_Setup_*-x64.exe",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "MoeKoeMusic/MoeKoeMusic",
          "assetPattern": "MoeKoe_Music_v{version}-amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "MoeKoeMusic/MoeKoeMusic",
          "assetPattern": "MoeKoe_Music_v{version}-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "MoeKoeMusic/MoeKoeMusic",
          "assetPattern": "MoeKoe_Music_v{version}-x64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "音乐播放器工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/MoeKoeMusic/MoeKoeMusic/b974ff5c5183be902ff92519f4fd905ec6cae93e/build/icons/icon.ico",
    "sha256": "fb177eecc4399097b8a7fd7ef332cb9a78ca19ffbf4db33e99950b16a00a06c6",
    "mime": "image/x-icon"
  },
  "description": "MoeKoeMusic 用于音乐播放器。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 打开软件并按提示登录或配置音乐服务。选择你有权播放的曲目，设置播放列表与音频输出。\n\n### 其他平台安装\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "category": "media",
  "screenshots": []
}
