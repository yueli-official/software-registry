        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "clash-verge-rev",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "windows",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "clash-verge-rev/clash-verge-rev",
          "assetPattern": "Clash.Verge_{version}_arm64-setup.exe",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "clash-verge-rev/clash-verge-rev",
