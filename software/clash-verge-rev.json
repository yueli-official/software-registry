          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "clash-verge-rev/clash-verge-rev",
          "assetPattern": "Clash.Verge_{version}_aarch64.app.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "clash-verge-rev/clash-verge-rev",
          "assetPattern": "Clash.Verge_{version}_amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "clash-verge-rev/clash-verge-rev",
          "assetPattern": "Clash.Verge_{version}_arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
