{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "deskreen",
  "name": "Deskreen",
  "homepage": "https://deskreen.com",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "deskreen",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pavlobu/deskreen",
          "assetPattern": "deskreen-ce_{version}_arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pavlobu/deskreen",
          "assetPattern": "deskreen-ce-{version}-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pavlobu/deskreen",
          "assetPattern": "deskreen-ce-{version}-x64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pavlobu/deskreen",
          "assetPattern": "deskreen-ce_{version}_amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "投屏工具。",
  "icon": {
    "url": "https://deskreen.com/images/apple-touch-icon.png",
    "sha256": "4382d806c582c58b2448b234eb7783321054eace0b46982885f65a7528ddacc4",
    "mime": "image/png"
  },
  "description": "Deskreen 用于投屏。",
  "usageInstructions": "1. 从下载区取得原版包，安装或解压后运行。\n2. 让电脑和接收设备处于同一局域网。打开软件，用接收设备浏览器访问生成的地址并确认连接，再选择共享窗口或屏幕。\n\n### 其他平台安装\n- Linux arm64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。",
  "faq": "下载版本和系统要求以下载区及官方说明为准。第三方服务的账号、API 密钥与订阅不包含在软件包内。",
  "category": "network",
  "screenshots": []
}
