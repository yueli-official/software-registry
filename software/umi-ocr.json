{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "umi-ocr",
  "name": "Umi-OCR",
  "homepage": "https://github.com/hiroi-sora/Umi-OCR",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "umi-ocr",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "hiroi-sora/Umi-OCR",
          "assetPattern": "Umi-OCR_Linux_Paddle_{version}.tar.xz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "OCR工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/hiroi-sora/Umi-OCR/83173efc4f4453b41223ea96d63d44534bf0505c/docs/images/icon-256.png",
    "sha256": "cda5b7c9de12c26ac17521f269191f935bbe82b00a25cdf9a7aabb3b4be09508",
    "mime": "image/png"
  },
  "description": "Umi-OCR 用于OCR。",
  "usageInstructions": "1. 从下载区取得原版包，安装或解压后运行。\n2. 启动软件，选择截图识别或导入图片。执行 OCR 后检查文字结果，再复制或导出；批量任务先用少量图片测试。\n\n### 其他平台安装\n- Linux amd64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。",
  "faq": "下载版本和系统要求以下载区及官方说明为准。第三方服务的账号、API 密钥与订阅不包含在软件包内。",
  "category": "capture",
  "screenshots": []
}
