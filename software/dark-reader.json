{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "dark-reader",
  "name": "Dark Reader",
  "homepage": "https://darkreader.org/",
  "kind": "chrome-extension",
  "packages": [
    {
      "platform": "windows",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "darkreader/darkreader",
          "tagPrefix": "v",
          "assetPattern": "darkreader-chrome-mv3.zip"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "darkreader/darkreader",
          "tagPrefix": "v",
          "assetPattern": "darkreader-chrome-mv3.zip",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "darkreader/darkreader",
          "tagPrefix": "v",
          "assetPattern": "darkreader-chrome-mv3.zip",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "浏览器深色模式扩展工具。",
  "icon": {
    "url": "https://darkreader.org/images/icon-256.png",
    "sha256": "d3816f245c6032f02fce3af7f13cac5e1f162a8af451d068353c468800b43d3f",
    "mime": "image/png"
  },
  "description": "Dark Reader 用于浏览器深色模式扩展。",
  "usageInstructions": "1. 下载官方 Chromium 扩展 ZIP 并解压到固定目录。\n2. 打开 Chromium 浏览器扩展管理页面，启用开发者模式，选择“加载已解压的扩展程序”并选中解压目录。\n3. 按官方说明配置功能与网站权限；目录须保留，普通用户也可选择官方扩展商店安装。",
  "faq": "这里提供官方 Chromium 扩展发行包，Windows、macOS 和 Linux 使用相同原包。它不是系统安装程序；手动加载需启用浏览器开发者模式。",
  "documentationUrl": "https://github.com/darkreader/darkreader/blob/main/README.md",
  "category": "browser",
  "screenshots": []
}
