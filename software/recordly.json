{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "recordly",
  "name": "Recordly",
  "homepage": "https://recordly.dev",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "webadderallorg/Recordly",
          "assetPattern": "Recordly-windows-x64.exe",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "webadderallorg/Recordly",
          "assetPattern": "Recordly-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "webadderallorg/Recordly",
          "assetPattern": "Recordly-linux-x64.AppImage",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "webadderallorg/Recordly",
          "assetPattern": "Recordly-x64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "自动变焦录屏工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/webadderallorg/Recordly/4fda917aff39729eb22e72bbb881c6b7123d4033/icons/icons/win/icon.ico",
    "sha256": "a9fd632d6b96c65dd57301b3ecb55eb88147b8a4511eb79f7de2a8c474512d5a",
    "mime": "image/x-icon"
  },
  "description": "Recordly 用于自动变焦录屏。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 选择录制窗口或屏幕，确认音频来源，先录制短片。录制后调整画面效果并导出自己的视频。\n\n### 其他平台安装\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- Linux amd64：为 AppImage 添加可执行权限后打开；发行版依赖以官方文档为准。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "documentationUrl": "https://github.com/webadderallorg/Recordly/blob/main/README.md",
  "category": "capture",
  "screenshots": []
}
