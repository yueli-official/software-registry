      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "main",
          "app": "frp",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "windows",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "fatedier/frp",
          "assetPattern": "frp_{version}_windows_arm64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "fatedier/frp",
          "assetPattern": "frp_{version}_darwin_amd64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "fatedier/frp",
          "assetPattern": "frp_{version}_darwin_arm64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "fatedier/frp",
          "assetPattern": "frp_{version}_linux_amd64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "fatedier/frp",
          "assetPattern": "frp_{version}_linux_arm64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
