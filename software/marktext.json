{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "marktext",
  "name": "MarkText",
  "homepage": "https://marktext.me/",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "marktext",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "windows",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "marktext/marktext",
          "assetPattern": "marktext-win-arm64-{version}.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "marktext/marktext",
          "assetPattern": "marktext-mac-x64-{version}.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "marktext/marktext",
          "assetPattern": "marktext-mac-arm64-{version}.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "marktext/marktext",
          "assetPattern": "marktext-linux-{version}.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "支持实时排版、表格和公式的开源Markdown编辑器。",
  "icon": {
    "url": "https://raw.githubusercontent.com/marktext/marktext/c2a7f59ffded1f565a0b3e74c4fda7edf4341771/packages/desktop/build/icons/256x256/marktext.png",
    "sha256": "d00f87911e70a76a4a9eb13da40e535fd2aa99486c768c1906156b6ba5df7c1b",
    "mime": "image/png",
    "provenance": "固定官方产品图标，已实际预览。蓝色M图标，根MIT许可，无该图标目录专用例外。"
  },
  "description": "MarkText 是可视化Markdown编辑器，边写边显示排版，支持表格、代码块、数学公式以及专注模式，可切换源码编辑并导出文档。适合写笔记、技术文档和博客，项目包含简体中文界面资源，文件保存在本地。采用MIT许可，原包及第三方许可保持不变。对应0.20.0版本源码与发行：https://github.com/marktext/marktext/releases/tag/v0.20.0 。",
  "usageInstructions": "1. Windows 10或11按x64或ARM64选择完整ZIP，解压后运行marktext.exe，保留全部目录文件。macOS 11及更新系统解压对应Intel或Apple Silicon的ZIP，将MarkText.app放入应用程序目录。Linux x64选择Debian包，由系统软件包工具安装依赖。\n2. 打开或新建.md文件，输入标题、列表和正文；可通过菜单插入表格、代码块和公式。\n3. 将文件保存到自己的笔记目录，需要查看原始标记时切换源码模式；在导出菜单选择PDF或HTML，导出后检查图片和字体。",
  "faq": "需要注册或云账户吗？本地编辑不要求账号，图片上传等联网服务需另行配置。\nWindows ZIP与安装器有什么区别？此条目Windows主源优先Scoop的原版ZIP；官方还提供安装器，可从Release取得。\nLinux有ARM64包吗？这个稳定Release的Linux成品是x64，不将缺失架构标为支持。",
  "documentationUrl": "https://marktext.me/docs/introduction",
  "category": "office",
  "screenshots": []
}
