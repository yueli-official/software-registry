{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "gitako",
  "name": "Gitako",
  "homepage": "https://chrome.google.com/webstore/detail/gitako/giljefjcheohhamkjphiebfjnlphnokk",
  "kind": "chrome-extension",
  "packages": [
    {
      "platform": "windows",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "EnixCoda/Gitako",
          "tagPrefix": "v",
          "assetPattern": "Gitako.zip"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "EnixCoda/Gitako",
          "tagPrefix": "v",
          "assetPattern": "Gitako.zip",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "EnixCoda/Gitako",
          "tagPrefix": "v",
          "assetPattern": "Gitako.zip",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "GitHub 浏览器扩展工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/EnixCoda/Gitako/f64526d45347670cf057e4580069279e989f7cec/Safari/Gitako/Gitako/Assets.xcassets/AppIcon.appiconset/Gitako-512.png",
    "sha256": "d54c63eb687f7d807760e19cdf6fce91d643697b82d57f3f0acbd093da606bfc",
    "mime": "image/png"
  },
  "description": "Gitako 用于GitHub 浏览器扩展。",
  "usageInstructions": "1. 下载官方 Chromium 扩展 ZIP 并解压到固定目录。\n2. 打开 Chromium 浏览器扩展管理页面，启用开发者模式，选择“加载已解压的扩展程序”并选中解压目录。\n3. 按官方说明配置功能与网站权限；目录须保留，普通用户也可选择官方扩展商店安装。",
  "faq": "这里提供官方 Chromium 扩展发行包，Windows、macOS 和 Linux 使用相同原包。它不是系统安装程序；手动加载需启用浏览器开发者模式。",
  "documentationUrl": "https://github.com/EnixCoda/Gitako/blob/develop/README.md",
  "category": "browser",
  "screenshots": []
}
