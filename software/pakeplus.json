{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "pakeplus",
  "name": "PakePlus",
  "homepage": "https://pakeplus.com",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Sjj1024/PakePlus",
          "assetPattern": "PakePlus_*_x64-setup.exe",
          "tagPrefix": "PakePlus-v"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Sjj1024/PakePlus",
          "assetPattern": "PakePlus_{version}_amd64.deb",
          "tagPrefix": "PakePlus-v",
          "tagTemplate": "PakePlus-v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Sjj1024/PakePlus",
          "assetPattern": "PakePlus_{version}_aarch64.dmg",
          "tagPrefix": "PakePlus-v",
          "tagTemplate": "PakePlus-v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Sjj1024/PakePlus",
          "assetPattern": "PakePlus_{version}_x64.dmg",
          "tagPrefix": "PakePlus-v",
          "tagTemplate": "PakePlus-v{version}"
        }
      }
    }
  ],
  "summary": "开发工具工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/Sjj1024/PakePlus/a66e498605af6a708d3b0b1b2368c49d47f83cdd/src-tauri/icons/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
    "sha256": "06ab38f8db7c56a9077eda58b1945bb3e9e54cb0d6d692dd59b3550fd6411ed1",
    "mime": "image/png"
  },
  "description": "PakePlus 用于开发工具。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 打开软件，输入需要封装的网页地址并配置应用名称。按软件提示生成应用，确认该网页允许相应使用方式。\n\n### 其他平台安装\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "category": "developer",
  "screenshots": []
}
