{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "grex",
  "name": "grex",
  "homepage": "https://github.com/pemistahl/grex",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "main",
          "app": "grex",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "windows",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pemistahl/grex",
          "assetPattern": "grex-v{version}-aarch64-pc-windows-msvc.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pemistahl/grex",
          "assetPattern": "grex-v{version}-x86_64-apple-darwin.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pemistahl/grex",
          "assetPattern": "grex-v{version}-aarch64-apple-darwin.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pemistahl/grex",
          "assetPattern": "grex-v{version}-x86_64-unknown-linux-musl.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pemistahl/grex",
          "assetPattern": "grex-v{version}-aarch64-unknown-linux-musl.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
