{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "gum",
  "name": "Gum",
  "homepage": "https://github.com/charmbracelet/gum",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "main",
          "app": "charm-gum",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "windows",
      "architecture": "386",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "charmbracelet/gum",
          "assetPattern": "gum_{version}_Windows_i386.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "charmbracelet/gum",
          "assetPattern": "gum_{version}_Darwin_x86_64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "charmbracelet/gum",
          "assetPattern": "gum_{version}_Darwin_arm64.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "charmbracelet/gum",
          "assetPattern": "gum_{version}_amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "charmbracelet/gum",
          "assetPattern": "gum_{version}_arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "386",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "charmbracelet/gum",
          "assetPattern": "gum_{version}_i386.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
