{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "nanobot",
  "name": "Nanobot",
  "homepage": "https://nanobot.wiki",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "HKUDS/nanobot",
          "assetPattern": "nanobot-tui-win32-x64.exe.zip",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "HKUDS/nanobot",
          "assetPattern": "nanobot-tui-darwin-arm64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "HKUDS/nanobot",
          "assetPattern": "nanobot-tui-darwin-x64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "HKUDS/nanobot",
          "assetPattern": "nanobot-tui-linux-arm64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "HKUDS/nanobot",
          "assetPattern": "nanobot-tui-linux-x64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
