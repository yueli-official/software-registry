{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "pot",
  "name": "Pot",
  "homepage": "https://pot-app.com",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "pot",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pot-app/pot-desktop",
          "assetPattern": "pot_{version}_arm64.deb",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "386",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pot-app/pot-desktop",
          "assetPattern": "pot_{version}_i386.deb",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pot-app/pot-desktop",
          "assetPattern": "pot_{version}_amd64.deb",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pot-app/pot-desktop",
          "assetPattern": "pot_{version}_aarch64.dmg",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "pot-app/pot-desktop",
          "assetPattern": "pot_{version}_x64.dmg",
          "tagPrefix": "",
          "tagTemplate": "{version}"
        }
      }
    }
  ],
  "summary": "划词翻译与 OCR工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/pot-app/pot-desktop/594d32ede96acd106b0256deaa8bb440ffcdff40/public/icon.svg",
    "sha256": "1609fc902e068483a4cd4986adeece096e5f103e4dd405352ab5db6c287bd782",
    "mime": "image/svg+xml"
  },
  "description": "Pot 用于划词翻译与 OCR。",
  "usageInstructions": "1. 从下载区取得原版包，安装或解压后运行。\n2. 运行软件，在设置中启用需要的翻译服务并填写服务要求的凭据。设置划词或截图快捷键，选择文本测试翻译。\n\n### 其他平台安装\n- Linux arm64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Linux 386：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "下载版本和系统要求以下载区及官方说明为准。第三方服务的账号、API 密钥与订阅不包含在软件包内。",
  "category": "capture",
  "screenshots": []
}
