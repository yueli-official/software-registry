{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "vlc",
  "name": "VLC media player",
  "homepage": "https://www.videolan.org/",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "vlc",
          "architecture": "64bit"
        }
      }
    }
  ],
  "summary": "播放常见音视频文件、光盘和网络媒体流。",
  "icon": {
    "url": "https://images.videolan.org/images/favicon.ico",
    "sha256": "8f80f6042654d323d0b9012e5a66e6824c277cd9ba49a2bd997333e186aa2ac4",
    "mime": "image/x-icon"
  },
  "description": "VLC media player：播放常见音视频文件、光盘和网络媒体流。",
  "usageInstructions": "1. 在下载区选择与你的系统相符的原版包，安装或解压。\n2. 打开视频、音频或合法网络媒体地址开始播放。按需要选择音轨、字幕与播放速度，检查输出设备。",
  "faq": "系统要求和功能限制以官方说明为准。操作重要文件、分区或配置前请先备份。",
  "category": "media",
  "screenshots": []
}
