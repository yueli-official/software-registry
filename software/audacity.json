{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "audacity",
  "name": "Audacity",
  "homepage": "https://www.audacityteam.org",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "audacity",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "audacity/audacity",
          "assetPattern": "audacity-linux-{version}-aarch64.AppImage",
          "tagPrefix": "Audacity-",
          "tagTemplate": "Audacity-{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "audacity/audacity",
          "assetPattern": "audacity-linux-{version}-x86_64.AppImage",
          "tagPrefix": "Audacity-",
          "tagTemplate": "Audacity-{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "audacity/audacity",
          "assetPattern": "audacity-macOS-{version}-universal.dmg",
          "tagPrefix": "Audacity-",
          "tagTemplate": "Audacity-{version}"
        }
      }
    }
  ],
  "summary": "支持多轨编辑与录音的音频处理工具。",
  "description": "Audacity：支持多轨编辑与录音的音频处理工具。",
  "usageInstructions": "1. 在下载区选择与你的系统相符的原版包，安装或解压。\n2. 导入音频或选择录音设备开始录音。选中波形片段进行剪切、音量或效果处理，再导出为需要的音频格式。\n\n### 其他平台安装\n- Linux arm64：为 AppImage 添加可执行权限后打开；发行版依赖以官方文档为准。\n- Linux amd64：为 AppImage 添加可执行权限后打开；发行版依赖以官方文档为准。\n- macOS universal：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求和功能限制以官方说明为准。操作重要文件、分区或配置前请先备份。",
  "documentationUrl": "https://manual.audacityteam.org/",
  "category": "media",
  "icon": {
    "url": "https://raw.githubusercontent.com/audacity/audacity/8de3891657f6348916a466239b01301d16399747/share/icons/AppIcon/AU4_AppIcon_512x512.png",
    "sha256": "8d7fc6b6875682dbf8f8bc8995522abf980ccebe9e79fac8386ff9b01f62dd05"
  },
  "screenshots": []
}
