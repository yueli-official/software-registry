{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "fluxdown",
  "name": "FluxDown",
  "homepage": "https://fluxdown.zerx.dev",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "fluxdown",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "android",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zerx-lab/FluxDown",
          "assetPattern": "FluxDown-{version}-android-universal.apk",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zerx-lab/FluxDown",
          "assetPattern": "FluxDown-{version}-linux-x64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zerx-lab/FluxDown",
          "assetPattern": "FluxDown-{version}-macos-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zerx-lab/FluxDown",
          "assetPattern": "FluxDown-{version}-macos-x64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "多协议下载与嗅探工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/zerx-lab/FluxDown/47764b8c89c70d6b82dd071d2a9ace12e413fdf8/mobile/Android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png",
    "sha256": "cc7b1f3b88656d5b613c6e88d90cb0f9bb09087b722a6d0967449869002be087",
    "mime": "image/png"
  },
  "description": "FluxDown 用于多协议下载与嗅探。",
  "usageInstructions": "1. 从下载区取得原版包，安装或解压后运行。\n2. 打开软件，添加下载链接并选择保存目录。需要媒体嗅探时使用软件提供的嗅探功能；仅保存你有权下载的内容。\n\n### 其他平台安装\n- Android universal：在 Android 设备打开 APK，按系统提示允许当前安装来源并安装；安装后可关闭该来源权限。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "下载版本和系统要求以下载区及官方说明为准。第三方服务的账号、API 密钥与订阅不包含在软件包内。",
  "category": "files",
  "screenshots": []
}
