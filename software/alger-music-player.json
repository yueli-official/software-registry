{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "alger-music-player",
  "name": "Alger Music Player",
  "homepage": "https://github.com/algerkong/AlgerMusicPlayer",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "algerkong/AlgerMusicPlayer",
          "assetPattern": "AlgerMusicPlayer-*-win-x64.exe",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "algerkong/AlgerMusicPlayer",
          "assetPattern": "AlgerMusicPlayer-{version}-linux-arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "algerkong/AlgerMusicPlayer",
          "assetPattern": "AlgerMusicPlayer-{version}-linux-amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "algerkong/AlgerMusicPlayer",
          "assetPattern": "AlgerMusicPlayer-{version}-mac-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "algerkong/AlgerMusicPlayer",
          "assetPattern": "AlgerMusicPlayer-{version}-mac-x64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "android",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "algerkong/AlgerMusicPlayer",
          "assetPattern": "AlgerMusicPlayer-{version}.apk",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "音乐播放器工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/algerkong/AlgerMusicPlayer/b277ef17a8d6f05152d42528e6930205b95d0fab/resources/icon-512.png",
    "sha256": "37c0139f446c8c7ad0246c07ebb5b9691bc5f0c56d592107364e398f420e3e18",
    "mime": "image/png"
  },
  "description": "Alger Music Player 用于音乐播放器。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 打开播放器，按需要登录音乐账号。搜索并选择可播放的歌曲，建立播放列表，再配置音质和输出设备。\n\n### 其他平台安装\n- Linux arm64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。\n- Android universal：在 Android 设备打开 APK，按系统提示允许当前安装来源并安装；安装后可关闭该来源权限。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "documentationUrl": "https://github.com/algerkong/AlgerMusicPlayer/blob/main/README.md",
  "category": "media",
  "screenshots": []
}
