{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "ludusavi",
  "name": "Ludusavi",
  "homepage": "https://github.com/mtkennerly/ludusavi",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "ludusavi",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "mtkennerly/ludusavi",
          "assetPattern": "ludusavi-v{version}-linux.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "mtkennerly/ludusavi",
          "assetPattern": "ludusavi-v{version}-mac.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "游戏存档备份工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/mtkennerly/ludusavi/70f4abb31497fa5ed9b0d24098200f3662d6fda9/assets/icon.ico",
    "sha256": "e346fe53fa217610a646325bdf505e1ef451fc7059b763c02f2c327f353b8b24",
    "mime": "image/x-icon"
  },
  "description": "Ludusavi 用于游戏存档备份。",
  "usageInstructions": "1. 从下载区取得原版包，安装或解压后运行。\n2. 先检查软件识别出的游戏和存档路径。预览将备份的文件，选择备份目录再执行；还原前备份当前存档。\n\n### 其他平台安装\n- Linux amd64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。\n- macOS arm64：解压原版包，应用拖入“应用程序”；命令行工具在终端按官方文档使用。",
  "faq": "下载版本和系统要求以下载区及官方说明为准。第三方服务的账号、API 密钥与订阅不包含在软件包内。",
  "category": "games",
  "screenshots": []
}
