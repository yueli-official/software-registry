{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "fluent-m3u8",
  "name": "Fluent M3U8",
  "homepage": "https://fluent-m3u8.org",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zhiyiYo/Fluent-M3U8",
          "assetPattern": "Fluent-M3U8-*-Windows-x86_64-Setup.exe",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zhiyiYo/Fluent-M3U8",
          "assetPattern": "Fluent-M3U8-v{version}-Linux-x86_64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zhiyiYo/Fluent-M3U8",
          "assetPattern": "Fluent-M3U8-v{version}-macOS-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "zhiyiYo/Fluent-M3U8",
          "assetPattern": "Fluent-M3U8-v{version}-macOS-x86_64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "流媒体下载工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/zhiyiYo/Fluent-M3U8/b78f52cc7b63fea803b112a113511697b13a3336/app/resource/images/logo.ico",
    "sha256": "637e4291dd0b2999dffff47b47bab28e19118cb3135f99695f2b43d7d0de3d6f",
    "mime": "image/x-icon"
  },
  "description": "Fluent M3U8 用于流媒体下载。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 添加 M3U8 地址并选择保存目录。开始任务后查看进度，下载完成后检查输出文件。\n\n### 其他平台安装\n- Linux amd64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
