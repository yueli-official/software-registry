{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "scrcpy",
  "name": "scrcpy",
  "homepage": "https://github.com/Genymobile/scrcpy",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "main",
          "app": "scrcpy",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Genymobile/scrcpy",
          "assetPattern": "scrcpy-linux-x86_64-v{version}.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Genymobile/scrcpy",
          "assetPattern": "scrcpy-macos-aarch64-v{version}.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "Genymobile/scrcpy",
          "assetPattern": "scrcpy-macos-x86_64-v{version}.tar.gz",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "在电脑上显示并控制 Android 设备。",
  "icon": {
    "url": "https://raw.githubusercontent.com/Genymobile/scrcpy/19c1261d2e2cbf2b5e6a71a8b64cc1dd3ede06ac/app/data/icon.ico",
    "sha256": "877268df171ed07782f0c8f7e65261bb34f30bfd35e3aa89f10aab83af22568b",
    "mime": "image/x-icon"
  },
  "description": "scrcpy：在电脑上显示并控制 Android 设备。",
  "usageInstructions": "1. 在下载区选择与你的系统相符的原版包，安装或解压。\n2. 在 Android 手机上开启 USB 调试，连接电脑并确认授权。在终端运行 scrcpy，手机画面出现后用鼠标键盘操作。\n\n### 其他平台安装\n- Linux amd64：解压原版归档，按官方文档运行程序；命令行工具从终端使用。\n- macOS arm64：解压原版包，应用拖入“应用程序”；命令行工具在终端按官方文档使用。\n- macOS amd64：解压原版包，应用拖入“应用程序”；命令行工具在终端按官方文档使用。",
  "faq": "系统要求和功能限制以官方说明为准。操作重要文件、分区或配置前请先备份。",
