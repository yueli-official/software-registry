{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "echomusic",
  "name": "EchoMusic",
  "homepage": "https://echomusic.cc.cd",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "hoowhoami/EchoMusic",
          "assetPattern": "EchoMusic-*-Windows-Setup-x64.exe",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "hoowhoami/EchoMusic",
          "assetPattern": "EchoMusic-{version}-linux-arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "hoowhoami/EchoMusic",
          "assetPattern": "EchoMusic-{version}-linux-amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "hoowhoami/EchoMusic",
          "assetPattern": "EchoMusic-{version}-macOS-arm64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "hoowhoami/EchoMusic",
          "assetPattern": "EchoMusic-{version}-macOS-x64.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "桌面音乐播放器工具。",
  "icon": {
    "url": "https://echomusic.cc.cd/icon.ico",
    "sha256": "3e8876cfdc82af2015ea1a790395c2cc1fe13688a324812b98dc16b50284198f",
    "mime": "image/x-icon"
  },
  "description": "EchoMusic 用于桌面音乐播放器。",
  "usageInstructions": "1. 取得下载区原版包，安装或解压后运行。\n2. 按首次启动提示配置音乐来源，选择有权播放的曲目。创建播放列表并检查音频输出，需要账号的服务另行登录。\n\n### 其他平台安装\n- Linux arm64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- macOS arm64：打开 DMG 并将应用拖入“应用程序”。\n- macOS amd64：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "系统要求、模型与第三方服务条件以官方说明为准。原软件的许可和使用限制仍适用。",
  "documentationUrl": "https://github.com/hoowhoami/EchoMusic/blob/main/README.md",
  "category": "media",
  "screenshots": []
}
