{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "readest",
  "name": "Readest",
  "homepage": "https://readest.com",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "scoop",
        "options": {
          "bucket": "extras",
          "app": "readest",
          "architecture": "64bit"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "readest/readest",
          "assetPattern": "Readest_{version}_arm64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "readest/readest",
          "assetPattern": "Readest_{version}_amd64.deb",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "android",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "readest/readest",
          "assetPattern": "Readest_{version}_universal.apk",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "universal",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "readest/readest",
          "assetPattern": "Readest_{version}_universal.dmg",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    }
  ],
  "summary": "电子书阅读工具。",
  "icon": {
    "url": "https://raw.githubusercontent.com/readest/readest/4c3ccfe85d4afd81e674b67d6a0627d83ba0744d/apps/readest-app/src-tauri/icons/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
    "sha256": "775804627fb70937d34c455016a4ca793dccef1fd9d961bce03e0bd920cac2bf",
    "mime": "image/png"
  },
  "description": "Readest 用于电子书阅读。",
  "usageInstructions": "1. 从下载区取得原版包，安装或解压后运行。\n2. 导入自己的电子书文件并打开。调整字体、主题和排版；可使用书签与阅读进度继续阅读。\n\n### 其他平台安装\n- Linux arm64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Linux amd64：适用于 Debian/Ubuntu 系，使用系统软件安装工具安装 .deb；先确认官方系统和依赖要求。\n- Android universal：在 Android 设备打开 APK，按系统提示允许当前安装来源并安装；安装后可关闭该来源权限。\n- macOS universal：打开 DMG 并将应用拖入“应用程序”。",
  "faq": "下载版本和系统要求以下载区及官方说明为准。第三方服务的账号、API 密钥与订阅不包含在软件包内。",
  "category": "reading",
  "screenshots": []
}
