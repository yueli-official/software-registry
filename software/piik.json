{
  "$schema": "../schemas/software.schema.json",
  "schemaVersion": 1,
  "id": "piik",
  "name": "Piik",
  "homepage": "https://piik.tv",
  "kind": "package",
  "packages": [
    {
      "platform": "windows",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "TNTcraftHIM/Piik",
          "assetPattern": "piik-app-windows-amd64.zip",
          "tagPrefix": "v"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "TNTcraftHIM/Piik",
          "assetPattern": "piik-app-darwin-amd64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "macos",
      "architecture": "arm64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "TNTcraftHIM/Piik",
          "assetPattern": "piik-app-darwin-arm64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "amd64",
      "channel": "stable",
      "source": {
        "driver": "github-release",
        "options": {
          "repository": "TNTcraftHIM/Piik",
          "assetPattern": "piik-app-linux-amd64.zip",
          "tagPrefix": "v",
          "tagTemplate": "v{version}"
        }
      }
    },
    {
      "platform": "linux",
      "architecture": "arm64",
